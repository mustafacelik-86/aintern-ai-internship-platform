# ─────────────────────────────────────────
# AIntern — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Groq API ──────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Groq Model ────────────────────────────
# Options: llama3-70b-8192 | llama-3.1-8b-instant | qwen/qwen3.6-27b | gemma2-9b-it
# Override with whatever model your Groq account has access to
GROQ_MODEL=llama3-70b-8192

# ── Supabase ──────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ── App Settings ──────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
